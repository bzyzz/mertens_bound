*.tmp*

# LaTeX byproducts
paper/*.log
paper/*.aux
paper/*.out

# Planted-recovery artefacts (regenerable: planted/plant.py rows, emulate.py)
search/planted/L*/
search/planted/*.pkl
search/planted/*.npz
search/planted/*.npy
search/planted/results_*
search/planted/emu_*
search/planted/e2e_*
